# Copia a .env (NO se sube a git) y cargalo en tu shell. Sin secretos: las claves van en keys/.
# PowerShell:  Get-Content .env | % { if ($_ -match '^\s*([^#=]+)=(.*)$') { Set-Item "env:$($matches[1].Trim())" $matches[2].Trim() } }
# bash:        set -a; source .env; set +a
SFL_MASTER_HOST=192.168.1.50      # IP LAN del servidor (ipconfig / ip addr). NO usar 127.0.0.1 en clientes fisicos
SFL_PORT=8080
SFL_MASTER_ID=MASTER
# SFL_KEYDIR=keys
# SFL_DATA_CSV=../data/adult.csv
# Parametros del experimento (opcionales; ver common/fl_config.py): SFL_ROUNDS, SFL_MIN_CLIENTS, SFL_ROUND_TIMEOUT ...
# SFL_ROUNDS=10
# SFL_MIN_CLIENTS=2
# SFL_ROUND_TIMEOUT=30
